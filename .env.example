# Multi-provider LLM Configuration (Free Tiers)
PROVIDER_CHAIN=["gemini","groq","openrouter"]

# Google Gemini (Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_RPM_LIMIT=15

# Groq (Free Tier)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_RPM_LIMIT=30

# OpenRouter (Free Tier)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_RPM_LIMIT=15

# Fast demo order overrides default LLM chain, with the lowest-latency healthy entries first.
# LLM_CHAIN_ORDER="groq/llama3-8b-8192, gemini/gemini-1.5-flash"
